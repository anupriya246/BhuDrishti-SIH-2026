# ─────────────────────────────────────────────────────────────────
# BhuDrishti — Backend Environment Variables
# Copy this file to .env and fill in real values before starting.
#   cp .env.example .env
# .env is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────

# ── Node / Express ────────────────────────────────────────────────
NODE_ENV=development          # development | production
PORT=3001                     # Express server port

# ── PostgreSQL ────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=bhudrishti
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here

# ── JWT ───────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── Flask ML API ──────────────────────────────────────────────────
# URL of the running Flask service (ml/api/app.py).
ML_API_URL=http://localhost:5000

# ── Authority Registration ────────────────────────────────────────
# Secret invite code required to register as district_admin or field_officer.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, authority registration is DISABLED (citizens can still register freely).
AUTHORITY_INVITE_CODE=replace_with_a_long_random_invite_code

# ── OTP / SMS Provider (optional) ────────────────────────────────
# Set ONE of the following to enable phone/OTP authentication.
# Until set, /send-otp returns 503 and users must use email login.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# MSG91_AUTH_KEY=your_msg91_key
# FAST2SMS_API_KEY=your_fast2sms_key

# ── Email / Password Reset (optional) ────────────────────────────
# Set to enable the Forgot Password email flow.
# Until set, /forgot-password logs the request but does not send email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your_smtp_password
# APP_URL=https://bhudrishti-sih-2026.vercel.app

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173

# ── Routing (OSRM) ────────────────────────────────────────────────
# Public OSRM demo server is used by default (no key required).
# OSRM_URL=https://router.project-osrm.org
