# ─────────────────────────────────────────────────────────────────
# BhuDrishti — Backend Environment Variables
# Copy this file to .env and fill in real values before starting.
#   cp .env.example .env
# .env is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────

# ── Node / Express ────────────────────────────────────────────────
NODE_ENV=development          # development | production
PORT=3001                     # Express server port

# ── PostgreSQL ────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=bhudrishti
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here

# ── JWT ───────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── Flask ML API ──────────────────────────────────────────────────
# URL of the running Flask service (ml/api/app.py).
# In development Flask runs locally on port 5000.
ML_API_URL=http://localhost:5000

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173

# ── Routing (OSRM) ────────────────────────────────────────────────
# Public OSRM demo server is used by default (no key required).
# Override with a self-hosted OSRM instance URL if needed.
# OSRM_URL=https://router.project-osrm.org
