# ─────────────────────────────────────────────────────────────────
# BhuDrishti — ML / Flask Environment Variables
# Copy this file to .env and fill in values before starting Flask.
#   cp .env.example .env
# .env is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────
FLASK_ENV=development         # development | production
FLASK_PORT=5000               # Port Flask listens on (default 5000)

# ── Open-Meteo ────────────────────────────────────────────────────
# Open-Meteo is a free, no-key API — no credentials required.
# The endpoint used is: https://api.open-meteo.com/v1/forecast
# No environment variable needed; the URL is hardcoded in forecast_alert.py.

# ── Model paths ───────────────────────────────────────────────────
# By default, models are loaded from ml/models/ relative to app.py.
# Override if you store trained artifacts elsewhere.
# MODELS_DIR=/absolute/path/to/models
